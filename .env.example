# Пример переменных окружения проекта «Квадро-Арсенал».
# Реальные значения задаются в .env.local (локально) или в настройках Amvera
# (production); .env.local исключён из Git.

# ——— Публичный сайт ———
# Токен бота и чат приёма заявок Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Cloudflare Turnstile для формы консультации.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ——— Личный кабинет ———
# Секрет HMAC-подписи demo-сессий. В production обязателен: без него вход
# невозможен (fail-closed).
ACCOUNT_SESSION_SECRET=
# Источник данных кабинета: demo (по умолчанию) | georitm.
ACCOUNT_DATA_SOURCE=demo
# Каталог серверного хранилища сессий (opaque-ID сессий входа через GEORITM).
# По умолчанию: /data/account-sessions на Amvera, .data/account-sessions в dev.
ACCOUNT_SESSION_STORE_DIR=

# ——— GEORITM (режим ACCOUNT_DATA_SOURCE=georitm) ———
# Адрес REST API с протоколом и портом, например http://IP:PORT.
# Сервисные учётные данные GEORITM здесь не нужны: пользователь входит
# своими учётными данными в форме кабинета, сервер хранит их только
# в серверном хранилище сессий.
GEORITM_BASE_URL=

# ——— Управление охраной (E12) ———
# Feature gate дистанционной постановки/снятия разделов с охраны
# (objects/arm/, objects/disarm/). Включается ТОЛЬКО значением 'true';
# отсутствие переменной и любое другое значение означают «выключено».
# В E12 gate не включается ни в одном окружении: включение возможно только
# после ответов поставщика и контрольной серии команд на тестовом контуре
# (см. docs/development/19-e12-arm-disarm-implementation.md).
GEORITM_CONTROL_ENABLED=
